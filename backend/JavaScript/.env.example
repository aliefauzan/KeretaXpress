# Application
APP_NAME=KeretaXpress
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
PORT=3000

# Database - PostgreSQL (Supabase)
DB_CONNECTION=postgresql
DB_HOST=your-db-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=payment-proofs

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS - Multiple origins separated by comma
CORS_ORIGIN=http://localhost:3001,https://keretaxpress-frontend-404674793847.asia-southeast2.run.app

# Midtrans Payment Gateway
MIDTRANS_MERCHANT_ID=your-merchant-id
MIDTRANS_CLIENT_KEY=your-client-key
MIDTRANS_SERVER_KEY=your-server-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_URL=https://app.sandbox.midtrans.com/snap/v1/transactions

# Cloud Scheduler Configuration
# URL of the scheduler service deployed on Cloud Run
SCHEDULER_URL=https://keretaxpress-scheduler-xxxxx.asia-southeast2.run.app
# Token for authenticating scheduler requests
SCHEDULER_TOKEN=your-secure-random-token-here
