# KeretaXpress Web - Environment Configuration Template
# Copy this file to .env.local and update with your actual values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Authentication Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production

# Application Settings
APP_NAME="KeretaXpress Web"
APP_ENV=development

# Optional: Analytics and Monitoring
NEXT_PUBLIC_GA_ID=your-google-analytics-id
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Optional: Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Development Database (if using local DB for caching)
DATABASE_URL=postgresql://username:password@localhost:5432/keretaxpress_dev

# Optional: External Services
NEXT_PUBLIC_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Production Environment Variables (for reference)
# NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api
# NEXTAUTH_SECRET=your-production-secret-key
# NEXT_PUBLIC_GA_ID=your-production-ga-id
# APP_ENV=production
